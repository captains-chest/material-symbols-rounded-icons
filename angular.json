{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "icon-pack": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "icon-pack:build:development",
            "compodoc": false,
            "tsConfig": "tsconfig.storybook.json",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "icon-pack:build:production",
            "compodoc": false,
            "tsConfig": "tsconfig.storybook.json",
            "outputDir": "storybook-static"
          }
        }
      }
    },
    "material-symbols-rounded-icons": {
      "projectType": "library",
      "root": "projects/material-symbols-rounded-icons",
      "sourceRoot": "projects/material-symbols-rounded-icons/src",
      "prefix": "msr",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/material-symbols-rounded-icons/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/material-symbols-rounded-icons/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "material-symbols-rounded-icons-filled": {
      "projectType": "library",
      "root": "projects/material-symbols-rounded-icons-filled",
      "sourceRoot": "projects/material-symbols-rounded-icons-filled/src",
      "prefix": "msrf",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/material-symbols-rounded-icons-filled/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/material-symbols-rounded-icons-filled/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
