{
  "name": "icon-pack",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib:outline": "ng build material-symbols-rounded-icons && node tools/icons/strip-sourcemap-comment.mjs --dist dist/material-symbols-rounded-icons",
    "build:lib:filled": "ng build material-symbols-rounded-icons-filled && node tools/icons/strip-sourcemap-comment.mjs --dist dist/material-symbols-rounded-icons-filled",
    "build:lib": "npm run build:lib:outline && npm run build:lib:filled",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sync:icons": "node tools/icons/sync-material-symbols-rounded.mjs --target all",
    "sync:icons:outline": "node tools/icons/sync-material-symbols-rounded.mjs --target outline",
    "sync:icons:filled": "node tools/icons/sync-material-symbols-rounded.mjs --target filled",
    "sync:icons:sample": "node tools/icons/sync-material-symbols-rounded.mjs --target all --sample",
    "verify:generated": "git diff --exit-code -- projects/material-symbols-rounded-icons/src/lib/icons projects/material-symbols-rounded-icons/src/lib/generated projects/material-symbols-rounded-icons-filled/src/lib/icons projects/material-symbols-rounded-icons-filled/src/lib/generated && test -z \"$(git ls-files --others --exclude-standard -- projects/material-symbols-rounded-icons/src/lib/icons/generated projects/material-symbols-rounded-icons/src/lib/generated projects/material-symbols-rounded-icons-filled/src/lib/icons/generated projects/material-symbols-rounded-icons-filled/src/lib/generated)\"",
    "verify:generated:sync": "npm run sync:icons && npm run verify:generated",
    "test:smoke": "node tools/icons/smoke-check.mjs",
    "test:security": "node --test tools/icons/svg-sanitizer.test.mjs tools/icons/upstream-policy.test.mjs",
    "ci:baseline": "npm run test:security && npm run verify:generated:sync && npm run build:lib && npm run test:smoke",
    "storybook": "ng run icon-pack:storybook",
    "build-storybook": "ng run icon-pack:build-storybook",
    "release:prepare": "npm run test:security && npm run verify:generated && npm run build:lib && npm run test:smoke",
    "release:check": "npm run release:prepare && cd dist/material-symbols-rounded-icons && npm pack --dry-run && cd ../material-symbols-rounded-icons-filled && npm pack --dry-run",
    "release:publish": "npm run release:prepare && cd dist/material-symbols-rounded-icons && npm publish --access public --provenance && cd ../material-symbols-rounded-icons-filled && npm publish --access public --provenance"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/angular": "^10.3.6",
    "@storybook/builder-vite": "^10.3.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.3.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
